# Used by `npm run build` for the dev server (https://callingapp-dev.zensark.com).
# The app is served at /patientpulse/ and its backend at /patientpulse-api/ (reverse proxy).
# Local development (`npm run dev`) ignores this file and keeps using / and /api.
VITE_BASE_PATH=/patientpulse/
VITE_API_BASE=/patientpulse-api/api
