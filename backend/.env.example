# Database
DATABASE_URL=sqlite+aiosqlite:///./patient_engagement.db

# JWT & Security
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Active users stay signed in; idle for this long (12 h) and they must sign in again
REFRESH_TOKEN_EXPIRE_MINUTES=720

# Twilio (Phase 2, placeholder for now)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Browser calling ("Call the Agent" page). Leave empty until set up in the Twilio console:
#   API key:   Account > API keys & tokens > Create API key
#   TwiML App: Voice > TwiML Apps > Voice Request URL = POST {API_BASE_URL}/twilio/clinic/inbound
#                                   Status Callback   = POST {API_BASE_URL}/twilio/clinic/status
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Real clinic number (when you have one). No code change is needed:
#   1. Put the number here (shown on the "Call the Agent" page):
CLINIC_INBOUND_NUMBER=
#   2. In the Twilio console, Phone Numbers > your number > Voice configuration:
#        "A call comes in"     -> Webhook, POST  https://YOUR-PUBLIC-DOMAIN/patientpulse-api/twilio/clinic/inbound
#        "Call status changes" ->          POST  https://YOUR-PUBLIC-DOMAIN/patientpulse-api/twilio/clinic/status
#      (replace https://YOUR-PUBLIC-DOMAIN/patientpulse-api with your API_BASE_URL below, e.g.
#       https://callingapp-dev.zensark.com/patientpulse-api on the dev server)

# Record calls; when true the agent's opening line says "This call is recorded for quality purposes."
CALL_RECORDING_ENABLED=false

# Claude/Anthropic (Phase 2)
ANTHROPIC_API_KEY=your-anthropic-api-key

# STT/TTS Services (Phase 2)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_PROJECT_ID=your-deepgram-project-id
SARVAM_API_KEY=your-sarvam-api-key

# App Config
APP_NAME=Patient Engagement for Chronic Disease Management
ORG_NAME=Hospital System
# Public HTTPS address of this backend, as Twilio sees it (Twilio webhooks and media streams use it).
# Dummy value: replace with yours, e.g. https://callingapp-dev.zensark.com/patientpulse-api
# (start-all.ps1 fills it with a Cloudflare tunnel address when running locally)
API_BASE_URL=https://YOUR-PUBLIC-DOMAIN/patientpulse-api
APP_PORT=8000

# Scheduler (Phase 3)
SCHEDULER_POLL_SECONDS=60
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=2,6,1440

# Agent Persona
AGENT_NAME=Health Assistant

# Inbound clinic call agent (optional - these are the defaults)
CLINIC_NAME=Sunrise Multispeciality Clinic
CLINIC_AGENT_NAME=Maya
CLINIC_UTC_OFFSET_MINUTES=330
CLINIC_BOOKING_DAYS_AHEAD=7

# Clinic facts the agent may share (leave empty = "not listed"; the agent offers a front-desk callback)
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_HOURS=
CLINIC_FEES=

# Safety wording (doctor to approve before going live)
EMERGENCY_NUMBER=108
# MENTAL_HEALTH_HELPLINE=the Tele-MANAS helpline on 14416, which is free and open all day and night
# HYPO_FIRST_AID=If you can swallow safely, please take something sugary right now, like a glass of juice or glucose.

# Calling hours for check-ins and callbacks (clinic time), and the default callback time
CHECKIN_CALL_START=09:00
CHECKIN_CALL_END=20:00
DEFAULT_CALLBACK_TIME=10:00
