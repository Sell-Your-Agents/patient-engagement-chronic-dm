# Database: a NEW, EMPTY PostgreSQL database for this schema (tables are created on startup / by seed.py)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/sixsigma_clinic
# PostgreSQL schema for this app (must already exist); empty = public
DATABASE_SCHEMA=six-sigma

# JWT & Security
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Active users stay signed in; idle for this long (12 h) and they must sign in again
REFRESH_TOKEN_EXPIRE_MINUTES=720

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Browser calling ("Call the Agent" page). Leave empty until set up in the Twilio console:
#   API key:   Account > API keys & tokens > Create API key
#   TwiML App: Voice > TwiML Apps > Voice Request URL = POST {API_BASE_URL}/twilio/clinic/inbound
#                                   Status Callback   = POST {API_BASE_URL}/twilio/clinic/status
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Real clinic number (when you have one). No code change is needed:
#   1. Put the number here (shown on the "Call the Agent" page):
CLINIC_INBOUND_NUMBER=
#   2. In the Twilio console, Phone Numbers > your number > Voice configuration:
#        "A call comes in"     -> Webhook, POST  https://YOUR-PUBLIC-DOMAIN/patientpulse-api/twilio/clinic/inbound
#        "Call status changes" ->          POST  https://YOUR-PUBLIC-DOMAIN/patientpulse-api/twilio/clinic/status
#      (replace https://YOUR-PUBLIC-DOMAIN/patientpulse-api with your API_BASE_URL below, e.g.
#       https://callingapp-dev.zensark.com/patientpulse-api on the dev server)

# Front-desk number (e.g. +919876543210). When set, a caller who asks for a person hears soft hold
# music while this number rings; if nobody answers within HUMAN_TRANSFER_RING_SECONDS they hear
# "all our staff are busy, our team will contact you soon" and a follow-up is left for staff.
# When empty, the agent takes a message (follow-up) instead. Needs TWILIO_PHONE_NUMBER, and in the
# Twilio console Voice > Settings > Geo permissions > India ticked. Not used on direct browser tests.
HUMAN_TRANSFER_NUMBER=
HUMAN_TRANSFER_RING_SECONDS=15
# HOLD_MUSIC_URL=http://com.twilio.music.classical.s3.amazonaws.com/ith_chopin-15-2.mp3

# Ending calls nobody is using: "Are you still there?" after this many silent seconds, then goodbye
# after this many more; and no call lasts longer than MAX_CALL_MINUTES (0 = no limit)
SILENCE_REPROMPT_SECONDS=8
SILENCE_HANGUP_SECONDS=8
MAX_CALL_MINUTES=15

# Record calls; when true the agent's opening line says "This call is recorded for quality purposes."
CALL_RECORDING_ENABLED=false

# Claude/Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Speech recognition (Deepgram) and voice (Sarvam)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_PROJECT_ID=your-deepgram-project-id
SARVAM_API_KEY=your-sarvam-api-key
# Agent voice: sarvam (default) or plivo (testing). Plivo needs the two keys below.
TTS_PROVIDER=sarvam
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token

# App Config
APP_NAME=Six Sigma Clinic AI Calling Agent
# Public HTTPS address of this backend, as Twilio sees it (Twilio webhooks and media streams use it).
# Dummy value: replace with yours, e.g. https://callingapp-dev.zensark.com/patientpulse-api
# (start-all.ps1 fills it with a Cloudflare tunnel address when running locally)
API_BASE_URL=https://YOUR-PUBLIC-DOMAIN/patientpulse-api
APP_PORT=8000

# ---- Clinic-specific configuration ----
CLINIC_NAME=Six Sigma Clinic
CLINIC_AGENT_NAME=Maya
CLINIC_UTC_OFFSET_MINUTES=330
CLINIC_BOOKING_DAYS_AHEAD=7
# Languages the agent offers (en = English, hi = Hindi, te = Telugu)
CLINIC_LANGUAGES=en,hi,te

# Clinic facts the agent may share (leave empty = "not listed"; the agent offers a callback)
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_HOURS=
CLINIC_FEES=

# Appointment system: "none" = no clinic system connected; every request is stored as pending
# and clinic staff confirm it (see app/services/scheduling/appointment_service.py)
APPOINTMENT_INTEGRATION=none

# Safety wording (doctor to approve before going live)
EMERGENCY_NUMBER=108
# MENTAL_HEALTH_HELPLINE=the Tele-MANAS helpline on 14416, which is free and open all day and night

# Hours clinic staff return calls (clinic time); the agent tells callers when to expect a call
STAFF_CALLBACK_START=09:00
STAFF_CALLBACK_END=20:00
